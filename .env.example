# ─────────────────────────────────────────────────────────────────────────────
# Monify — contoh konfigurasi. Salin menjadi `.env` dan isi nilainya.
# `npm run dev` tidak butuh file ini: ia menyalakan Postgres lokal sendiri.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL. Di serverless (Vercel + Supabase) pakai URL pooler:
#   postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Secret penanda tangan cookie sesi. WAJIB di production, minimal 32 karakter acak.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=""

# URL publik aplikasi (untuk tautan reset password), tanpa garis miring di akhir.
APP_URL="http://localhost:3000"

# Zona waktu untuk menentukan "hari ini" bila klien tidak mengirim tanggalnya.
APP_TIMEZONE="Asia/Jakarta"

# Email yang boleh membuka halaman admin, dipisah koma.
ADMIN_EMAILS=""

# ── Lampiran & struk (opsional). Tanpa ini, file disimpan di disk lokal ./storage ──
# Bucket HARUS privat. Service-role key hanya boleh ada di server.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="attachments"

# ── Email transaksional via Resend (opsional). Tanpa ini reset password tidak mengirim email ──
RESEND_API_KEY=""
MAIL_FROM="Monify <no-reply@domain-anda.com>"

# ── AI receipt scanner (opsional). Tanpa ini fitur scan disembunyikan; input manual tetap ada ──
ANTHROPIC_API_KEY=""
RECEIPT_MODEL="claude-opus-5-5"

# ── Akun demo untuk `npm run dev:seed` (hanya database lokal) ──
DEMO_USER_EMAIL="demo@monify.local"
DEMO_USER_PASSWORD="demo123456"

# Port server
PORT=3000
