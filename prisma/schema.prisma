generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Konvensi:
// - Semua nominal uang disimpan sebagai BigInt dalam satuan terkecil mata uang
//   (IDR: rupiah, USD: sen). Tidak ada floating-point.
// - Tanggal transaksi adalah tanggal kalender pilihan pengguna, disimpan pada
//   12:00 UTC hari itu sehingga tidak bergeser oleh zona waktu.
// - Saldo dompet (`Wallet.balance`) hanya boleh diubah oleh server/services/ledger.js.

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String?
  passwordHash    String?
  /// Mata uang utama untuk ringkasan: IDR | USD
  displayCurrency String   @default("IDR")
  /// DMY | MDY | YMD
  dateFormat      String   @default("DMY")
  /// Locale pemformatan angka, mis. id-ID | en-US
  numberFormat    String   @default("id-ID")
  /// dark | light | system
  theme           String   @default("system")
  defaultWalletId String?
  /// Waktu pengguna menyetujui pemrosesan struk oleh AI (null = belum setuju)
  aiConsentAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  wallets         Wallet[]
  categories      Category[]
  transactions    Transaction[]
  budgets         Budget[]
  categoryParents CategoryParent[]
  transfers       Transfer[]
  debts           Debt[]
  debtPayments    DebtPayment[]
  savingsGoals    SavingsGoal[]
  savingsEntries  SavingsEntry[]
  resetTokens     PasswordResetToken[]
  auditLogs       AuditLog[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 dari token; token asli hanya ada di tautan email
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Induk kategori (preset sistem userId=null, atau buatan pengguna)
model CategoryParent {
  id         String     @id @default(cuid())
  userId     String?
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  kind       String // expense | income | debt
  sortOrder  Int        @default(0)
  categories Category[]

  @@index([userId, kind])
}

model Wallet {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  /// cash | bank | ewallet | savings | investment | other
  type           String   @default("bank")
  currency       String
  /// Saldo awal saat dompet dibuat. Bukan pemasukan; tidak masuk laporan.
  initialBalance BigInt   @default(0)
  /// Saldo berjalan = initialBalance + Σ mutasi transaksi berstatus success.
  balance        BigInt   @default(0)
  /// false = diarsipkan (tidak muncul di pemilih, riwayat tetap ada)
  active         Boolean  @default(true)
  flag           String
  logo           String?
  color          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  transactions Transaction[]
  budgets      Budget[]
  transfersOut Transfer[]    @relation("TransferFrom")
  transfersIn  Transfer[]    @relation("TransferTo")
  debts        Debt[]
  savingsGoals SavingsGoal[]

  @@index([userId])
}

model Category {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         String // expense | income | debt (debt = warisan, sudah diarsipkan)
  debtSubtype  String?
  icon         String
  color        String?
  /// true = disembunyikan dari pemilih; transaksi lama tetap menampilkannya
  archived     Boolean         @default(false)
  parentId     String?
  parent       CategoryParent? @relation(fields: [parentId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([userId, type])
}

/// Budget per kategori daun ATAU per induk kategori (agregat anak).
/// Bulanan: year + month. Kustom: periodStart + periodEnd.
/// walletId null = semua dompet; terisi = hanya pengeluaran dari dompet itu.
model Budget {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  year        Int?
  month       Int?
  limitAmount BigInt
  targetKind  String // CATEGORY | PARENT
  targetId    String
  walletId    String?
  wallet      Wallet?   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  periodStart DateTime?
  periodEnd   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

/// Satu baris = satu mutasi pada satu dompet.
model Transaction {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId   String
  wallet     Wallet    @relation(fields: [walletId], references: [id], onDelete: Restrict)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Selalu positif.
  amount     BigInt
  /// Menentukan perlakuan di laporan:
  /// expense | income  -> masuk laporan pemasukan/pengeluaran
  /// transfer          -> pemindahan dana, tidak masuk laporan
  /// debt              -> pokok hutang/piutang dan pembayarannya, tidak masuk laporan
  /// adjustment        -> koreksi saldo, tidak masuk laporan
  kind       String    @default("expense")
  /// in | out — arah mutasi terhadap dompet
  direction  String    @default("out")
  /// Kolom warisan (expense | income | debt | transfer | adjustment); diisi sama dengan kind.
  type       String
  title      String
  date       DateTime
  status     String    @default("success") // success | pending
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  currency   String    @default("IDR")
  counterparty String?
  relatedParty String?
  /// URL publik warisan (unggahan lama). Unggahan baru memakai attachmentKey.
  imageUrl      String?
  /// Kunci objek di penyimpanan privat; hanya bisa diambil lewat API ber-otorisasi.
  attachmentKey String?
  /// manual | receipt_ai
  source        String   @default("manual")

  transferId String?
  transfer   Transfer? @relation(fields: [transferId], references: [id], onDelete: Cascade)
  debtId     String?
  debt       Debt?     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  payment    DebtPayment?

  /// Kunci dari klien untuk mencegah transaksi ganda saat request terkirim ulang.
  idempotencyKey String?

  // ——— Kolom warisan model hutang lama; tidak lagi ditulis, dipertahankan untuk jejak data ———
  parentTransactionId String?
  remainingAmount     BigInt?
  paidOff             Boolean @default(false)

  @@unique([userId, idempotencyKey])
  @@index([userId, date])
  @@index([userId, kind, date])
  @@index([walletId, date])
  @@index([categoryId])
  @@index([transferId])
  @@index([debtId])
}

/// Pemindahan dana antar dompet milik pengguna sendiri. Selalu punya tepat dua
/// baris Transaction (out pada sumber, in pada tujuan) yang dibuat/dihapus bersama.
model Transfer {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromWalletId   String
  fromWallet     Wallet   @relation("TransferFrom", fields: [fromWalletId], references: [id], onDelete: Restrict)
  toWalletId     String
  toWallet       Wallet   @relation("TransferTo", fields: [toWalletId], references: [id], onDelete: Restrict)
  amount         BigInt
  date           DateTime
  note           String?
  idempotencyKey String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  transactions Transaction[]
  savingsEntry SavingsEntry?

  @@unique([userId, idempotencyKey])
  @@index([userId, date])
}

/// PAYABLE    = hutang: uang yang harus saya bayar ke orang lain.
/// RECEIVABLE = piutang: uang yang harus dibayar orang lain kepada saya.
model Debt {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String // PAYABLE | RECEIVABLE
  personName  String
  principal   BigInt
  /// principal − Σ pembayaran. Dihitung ulang server pada setiap perubahan pembayaran.
  outstanding BigInt
  date        DateTime
  dueDate     DateTime?
  description String?
  status      String    @default("OPEN") // OPEN | PAID
  walletId    String?
  wallet      Wallet?   @relation(fields: [walletId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  payments     DebtPayment[]
  transactions Transaction[]

  @@index([userId, status])
}

model DebtPayment {
  id            String       @id @default(cuid())
  debtId        String
  debt          Debt         @relation(fields: [debtId], references: [id], onDelete: Cascade)
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        BigInt
  date          DateTime
  note          String?
  /// Mutasi dompet yang merepresentasikan pembayaran ini (satu-ke-satu).
  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@index([debtId, date])
}

model SavingsGoal {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  targetAmount BigInt
  /// Σ SavingsEntry.amount. Dihitung ulang server.
  savedAmount  BigInt    @default(0)
  targetDate   DateTime?
  icon         String?
  color        String?
  /// Dompet tempat uang tabungan ini benar-benar disimpan (opsional).
  walletId     String?
  wallet       Wallet?   @relation(fields: [walletId], references: [id], onDelete: SetNull)
  status       String    @default("ACTIVE") // ACTIVE | ACHIEVED | ARCHIVED
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  entries SavingsEntry[]

  @@index([userId, status])
}

/// amount positif = setoran, negatif = penarikan.
model SavingsEntry {
  id         String      @id @default(cuid())
  goalId     String
  goal       SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     BigInt
  date       DateTime
  note       String?
  /// Terisi bila setoran/penarikan ini benar-benar memindahkan uang antar dompet.
  transferId String?     @unique
  transfer   Transfer?   @relation(fields: [transferId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())

  @@index([goalId, date])
}

/// Jejak aktivitas finansial dan keamanan yang penting.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Penyimpanan sesi (wajib untuk lingkungan serverless)
model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime

  @@index([expiresAt])
}
