{
  "version": 2,
  "regions": ["sin1"],
  "builds": [
    {
      "src": "server/index.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["public/**", "prisma/schema.prisma"] }
    },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/assets/[a-f0-9]{12}/(.*\\.(?:css|js|woff2|png|jpg|jpeg|webp|svg|ico|txt))",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "dest": "/public/$1"
    },
    {
      "src": "/((?:css|js|assets)/.*\\.(?:css|js|woff2|png|jpg|jpeg|webp|svg|ico))",
      "headers": { "cache-control": "public, max-age=3600" },
      "dest": "/public/$1"
    },
    { "src": "/(.*)", "dest": "server/index.js" }
  ]
}
